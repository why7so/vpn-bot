# --- Telegram ---
BOT_TOKEN=123456:ABC-your-telegram-bot-token
ADMIN_IDS=111111111,222222222

# --- Выдача VPN-доступа ---
# Пока собственный мастер-сервер не готов, services/vpn_provider.py работает
# как заглушка (выдаёт фиктивную подписку) — остальная логика бота (оплата,
# промокоды, продления) при этом работает без изменений.
MASTER_API_BASE_URL=
MASTER_API_TOKEN=
# Секрет для входящего вебхука от мастер-сервера о подключении устройства
# (POST /webhook/device-connected -> пользователь получает уведомление в
# боте с информацией об устройстве). Пока не задан — эндпоинт отключён (503).
MASTER_WEBHOOK_SECRET=
VPN_EMAIL_PREFIX=tgbot_

# --- Crypto Pay (@CryptoBot) ---
# Получить в https://t.me/CryptoBot -> Crypto Pay -> Create App
CRYPTO_PAY_TOKEN=your_crypto_pay_api_token
CRYPTO_PAY_API_URL=https://pay.crypt.bot/api
# Тестовая сеть: https://testnet-pay.crypt.bot/api

# --- LAVA (lava.ru) — оплата в рублях (карта/СБП) ---
# Токен: https://lava.ru/dashboard/settings/api
# Нужен статус самозанятого/ИП/юрлица + модерация проекта в ЛК LAVA.
LAVA_API_TOKEN=your_lava_api_token
LAVA_API_URL=https://api.lava.ru

# --- Прочее ---
# PostgreSQL на мастер-сервере (общая БД). Формат:
# postgresql+asyncpg://user:password@host:5432/dbname
# Если не задан — бот работает на локальном SQLite-файле (DB_PATH ниже).
DATABASE_URL=
# Используется только как фолбэк, если DATABASE_URL не задан.
DB_PATH=bot.db
SUPPORT_USERNAME=your_support_username
VPN_NAME=Unnamed VPN

# Кастомные эмодзи-иконки на кнопках главного меню (Bot API 9.4+, требуется
# aiogram>=3.20 и Telegram Premium у владельца бота — иначе поле молча
# игнорируется Telegram). Необязательно, можно оставить пустыми.
# Как получить ID: напишите боту команду /getemojiid (только для админов из
# ADMIN_IDS), затем пришлите ему сообщение с нужным премиум-эмодзи — бот
# ответит его custom_emoji_id.
ICON_EMOJI_BUY=5904462880941545555
ICON_EMOJI_ACCOUNT=6035084557378654059
ICON_EMOJI_CONNECT_DEVICE=6028171274939797252
ICON_EMOJI_ABOUT=6028435952299413210
ICON_EMOJI_SUPPORT=
# Максимум одновременных устройств (подключений) на одного клиента.
# 0 = без ограничений.
DEVICE_LIMIT=3
# Жёсткий потолок итогового лимита устройств (базовый + докупленные) по одной
# ссылке-подписке — реальное ограничение протокола/VPN-панели. Дальше докупка
# устройств блокируется. 0 = без потолка.
MAX_DEVICE_LIMIT=60
# Цена одного дополнительного устройства сверх лимита (доп. услуга в боте/мини-аппе)
EXTRA_DEVICE_PRICE_RUB=40
EXTRA_DEVICE_PRICE_USDT=0.45
# Реферальная программа: бонус пригласившему за каждого нового друга и
# единоразовый бонус самому другу при первом /start по реф. ссылке.
REFERRAL_BONUS_RUB=15
REFERRAL_INVITEE_BONUS_RUB=49

# --- Telegram Mini App (WebApp) — личный кабинет ---
# URL задеплоенного фронтенда (Vercel/Netlify), напр. https://myvpn.vercel.app
# Оставьте пустым, если мини-приложение пока не используется.
WEBAPP_URL=
# На каком хосте/порту слушает backend API мини-приложения (webapp/api.py).
# Наружу пробрасывается через nginx/caddy с HTTPS на своём домене/поддомене.
API_HOST=0.0.0.0
API_PORT=8080
# Origin фронтенда для CORS (в проде — конкретный https://..., НЕ "*")
API_CORS_ORIGIN=https://myvpn.vercel.app
