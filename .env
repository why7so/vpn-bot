# --- Telegram ---
BOT_TOKEN=123456:ABC-your-telegram-bot-token
ADMIN_IDS=111111111,222222222

# --- Выдача VPN-доступа ---
# Пока собственный мастер-сервер не готов, services/vpn_provider.py работает
# как заглушка (выдаёт фиктивную подписку) — остальная логика бота (оплата,
# промокоды, продления) при этом работает без изменений.
MASTER_API_BASE_URL=
MASTER_API_TOKEN=
VPN_EMAIL_PREFIX=tgbot_

# --- Crypto Pay (@CryptoBot) ---
# Получить в https://t.me/CryptoBot -> Crypto Pay -> Create App
CRYPTO_PAY_TOKEN=your_crypto_pay_api_token
CRYPTO_PAY_API_URL=https://pay.crypt.bot/api
# Тестовая сеть: https://testnet-pay.crypt.bot/api

# --- LAVA (lava.ru) — оплата в рублях (карта/СБП) ---
# Токен: https://lava.ru/dashboard/settings/api
# Нужен статус самозанятого/ИП/юрлица + модерация проекта в ЛК LAVA.
LAVA_API_TOKEN=your_lava_api_token
LAVA_API_URL=https://api.lava.ru

# --- Прочее ---
DB_PATH=bot.db
SUPPORT_USERNAME=your_support_username
VPN_NAME=Unnamed VPN
# Максимум одновременных устройств (подключений) на одного клиента.
# 0 = без ограничений.
DEVICE_LIMIT=3
# Цена одного дополнительного устройства сверх лимита (доп. услуга в боте/мини-аппе)
EXTRA_DEVICE_PRICE_RUB=40
EXTRA_DEVICE_PRICE_USDT=0.45

# --- Telegram Mini App (WebApp) — личный кабинет ---
# URL задеплоенного фронтенда (Vercel/Netlify), напр. https://myvpn.vercel.app
# Оставьте пустым, если мини-приложение пока не используется.
WEBAPP_URL=
# На каком хосте/порту слушает backend API мини-приложения (webapp/api.py).
# Наружу пробрасывается через nginx/caddy с HTTPS на своём домене/поддомене.
API_HOST=0.0.0.0
API_PORT=8080
# Origin фронтенда для CORS (в проде — конкретный https://..., НЕ "*")
API_CORS_ORIGIN=https://myvpn.vercel.app
